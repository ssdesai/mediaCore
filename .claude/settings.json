{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/agentTooling/hooks/allow-repo-commands.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/plans/cloud-setup.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/.git/**)",
      "Edit(**/.git/**)",
      "Edit(**/.git)",
      "Edit(/.claude/**)",
      "Edit(**/.claude/**)",
      "Edit(**/.venv/**)",
      "Edit(**/venv/**)",
      "Edit(**/node_modules/**)",
      "Edit(**/agentTooling/hooks/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git switch -c:*)",
      "Bash(git switch -C:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git worktree move:*)",
      "Bash(git worktree lock:*)",
      "Bash(git worktree unlock:*)",
      "Bash(git worktree repair:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",
      "Bash(git stash push:*)",
      "Bash(git stash save:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash branch:*)",
      "Bash(git stash create:*)",
      "Bash(git stash store:*)",
      "Bash(git stash)"
    ],
    "ask": [
      "Edit(**/agentTooling/hooks/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.anthropic.com",
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com"
      ]
    }
  }
}
