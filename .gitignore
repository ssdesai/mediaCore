# This file ships with the subtree, so it must hold for both a standalone agentTooling
# checkout and a vendored copy inside a consuming repo. Patterns are relative to this
# directory in both cases, and the consuming repo's own plans/**/ patterns do not reach
# in here.

# run-plans.sh / run-verify.sh / run-review.sh raw event streams from --self runs — 0.2-1.5 MB each,
# kept on disk as the full record of what an executor did, never committed.
self/**/*.stream.jsonl
self/**/*.logfifo

# Output of self/gate.sh — regenerated on every --self batch, read by the verify and
# review plans. The glob also covers gate-report.<NN>.txt, written per level sentinel.
self/gate-report*.txt

# The review pass's verdict for a --self batch, used verbatim as the body of the PR
# self/pr.sh opens. See the consuming-repo note in the root .gitignore.
self/review-report.md

# This checkout's own permission policy, GENERATED per checkout by
# `python3 -B hooks/wire-settings.py --self --repo <root> --write` — self/worktree-setup.sh
# runs it in each new worktree, feature-start.sh --self in a primary that has lost it.
# Never tracked: a tracked copy ships with the subtree and hands every consuming repo an
# agentTooling/.claude/settings.json naming a hook path that does not exist there.
.claude/settings.json

# analysis/ scripts are stdlib-only and run directly, but python still writes these.
__pycache__/
*.py[cod]

# macOS. A tracked .DS_Store aborts `git subtree add/pull/push`, which require a clean
# working tree even for changes unrelated to the prefix.
.DS_Store
